{
  "_comment": "English (US) QWERTY, matching Gboard 15. Format documented in ime/layout/Layouts.kt (KeyboardLanguage).",
  "locale": "en-US",
  "name": "English (US)",
  "shortName": "EN",
  "rtl": false,
  "pages": {
    "letters": {
      "rows": [
        {
          "keys": ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
          "hints": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
          "symbols": ["%", "^", "~", "|", "[", "]", "<", ">", "{", "}"]
        },
        {
          "keys": ["a", "s", "d", "f", "g", "h", "j", "k", "l"], "indent": 0.5,
          "symbols": ["@", "#", "$", "_", "&", "-", "+", "(", ")"]
        },
        {
          "keys": [{"fn": "shift", "w": 1.5}, "z", "x", "c", "v", "b", "n", "m", {"fn": "delete", "w": 1.5}],
          "symbols": ["", "*", "\"", "'", ":", ";", "!", "?", ""]
        },
        {"template": "bottom_letters"}
      ],
      "more": {
        "e": ["é", "è", "ê", "ë", "ē"],
        "u": ["ú", "û", "ü", "ù", "ū"],
        "i": ["í", "î", "ï", "ì", "ī"],
        "o": ["ó", "ô", "ö", "ò", "œ", "ø", "ō", "õ"],
        "a": ["à", "á", "â", "ä", "æ", "ã", "å", "ā"],
        "s": ["ß"],
        "c": ["ç"],
        "n": ["ñ"]
      }
    },
    "symbols": {
      "rows": [
        {"keys": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]},
        {"keys": ["@", "#", "$", "_", "&", "-", "+", "(", ")", "/"]},
        {
          "keys": [{"fn": "symbols_more", "w": 1.5}, "*", "\"", "'", ":", ";", "!", "?", {"fn": "delete", "w": 1.5}]
        },
        {"template": "bottom_symbols"}
      ],
      "more": {
        "1": ["1", "½", "⅓", "¼", "⅕", "⅙", "⅐", "⅛", "⅑", "⅒"],
        "2": ["2", "²", "⅔"],
        "3": ["3", "³", "¾", "⅜"],
        "4": ["4", "⁴"],
        "5": ["5", "⅝"],
        "7": ["7", "⅞"],
        "0": ["0", "ⁿ", "∅"],
        "$": ["¢", "£", "€", "¥", "₱"],
        "&": ["§"],
        "-": ["_", "—", "–", "·"],
        "+": ["±"],
        "(": ["<", "{", "["],
        ")": [">", "}", "]"],
        "*": ["†", "‡", "★"],
        "\"": ["”", "»", "“", "«", "„"],
        "'": ["’", "‹", "‘", "›", "‚"],
        "!": ["¡"],
        "?": ["¿"],
        "6": ["6"],
        "8": ["8"],
        "9": ["9"],
        "#": ["№"]
      }
    },
    "symbols_more": {
      "rows": [
        {"keys": ["~", "`", "|", "•", "√", "π", "÷", "×", "§", "∆"]},
        {"keys": ["£", "¢", "€", "¥", "^", "°", "=", "{", "}", "\\"]},
        {
          "keys": [{"fn": "symbols", "w": 1.5, "label": "?123"}, "%", "©", "®", "™", "✓", "[", "]", {"fn": "delete", "w": 1.5}]
        },
        {"template": "bottom_symbols_more"}
      ],
      "more": {"%": ["‰"], "=": ["≠", "≈", "∞"], "π": ["Π"], "°": ["′", "″"]}
    }
  }
}
