<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.pboard.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true">
    <!-- English (UK) first: the primary subtype. Both use QWERTY; the locale selects layout data and lexicon. -->
    <subtype android:label="English (UK)" android:imeSubtypeLocale="en_GB"
        android:imeSubtypeMode="keyboard" android:languageTag="en-GB"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=qwerty,AsciiCapable,EmojiCapable"
        android:isAsciiCapable="true" />
    <subtype android:label="English (US)" android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" android:languageTag="en-US"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=qwerty,AsciiCapable,EmojiCapable"
        android:isAsciiCapable="true" />
</input-method>
