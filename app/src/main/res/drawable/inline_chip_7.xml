<?xml version="1.0" encoding="utf-8"?>
<!-- Inline autofill chip background (CX-14): a pill inset 7 dp top and bottom, 4 dp at the sides; white, tinted
     to the key colour by the request style. Rendered by the autofill service from our resources. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="7dp" android:insetBottom="7dp" android:insetLeft="4dp" android:insetRight="4dp">
    <shape android:shape="rectangle">
        <corners android:radius="1000dp" />
        <solid android:color="#FFFFFFFF" />
    </shape>
</inset>
