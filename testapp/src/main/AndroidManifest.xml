<?xml version="1.0" encoding="utf-8"?>
<!-- Test fixtures only (see build.gradle.kts). No permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="pboard test fixtures" android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <!-- Select with: adb shell settings put secure autofill_service dev.pboard.testapp/.TestAutofillService -->
        <service
            android:name=".TestAutofillService"
            android:exported="true"
            android:label="pboard test autofill"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <receiver android:name=".ConfigReceiver" android:exported="true" />
        <receiver android:name=".ClipReceiver" android:exported="true" />
        <!-- am start -n dev.pboard.testapp/.LoginActivity -->
        <activity android:name=".LoginActivity" android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!-- am start -n dev.pboard.testapp/.RichContentActivity : a field that accepts images (commitContent) -->
        <activity android:name=".RichContentActivity" android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    </application>
</manifest>
