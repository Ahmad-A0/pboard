# Machine-local settings. Copy to local.env (gitignored) and fill in; every key is optional until a tool needs it.
# Read by tools/dev/local_env.sh, tools/dev/local_env.py and build.gradle.kts. Environment variables win.

# adb serial of a real test phone (tools/phone/guard.sh and the on-device benchmarks). Gradle device tasks refuse
# this device unless they run inside tools/phone/guard.sh.
#PBOARD_PHONE_SERIAL=192.0.2.10:5555

# ssh host of a remote emulator farm (tools/farm/pool.sh runs there): tools/conformance/run.sh --pool and
# analyze_remote.sh.
#PBOARD_FARM_HOST=farm.example.org

# Address tools/release/serve_repo.sh binds to (a private interface address), and optionally its port.
#PBOARD_REPO_BIND=192.0.2.1
#PBOARD_REPO_PORT=8737
